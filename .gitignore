# Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
**/dist/
**/build/
*.log

# Environment files
.env
.env.*
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
.cache/
nul

# Heavy binaries (do not commit)
*.exe
*.dmg
*.msi
*.deb
*.rpm
*.AppImage

# Screenshots & test artifacts (root only)
/*.png
/screenshots/
/.playwright-mcp/

# Playwright artifacts (see playwright.config.ts)
#
# Sin la barra inicial: `app/test-results/` y `player/test-results/` son
# exactamente los mismos artefactos que los de la raíz, y con `/test-results/`
# quedaban sin ignorar (aparecían como decenas de archivos sin trackear).
test-results/
playwright-report/
blob-report/
/playwright/.cache/

# Demo MIDI / RIVE files at root (use app/public/demo/ instead)
/*.mid
/*.riv

# One-off scripts at root
/fix-*.js
/fix-*.py
/test-*.js
/test-*.html

# Coverage
coverage/

# Vite logs
**/vite*.log

# Salidas del runner acotado (scripts/run-bounded.ps1)
/.logs/

# Sondas y volcados de un solo uso de `scripts/` (prefijo `tmp-` por convención
# del repo). Son instrumentos de una investigación puntual, no herramientas:
# lo que se quiere conservar se renombra sin el prefijo (como los `qa-*.mjs`).
/scripts/tmp-*
# Volcado del descubrimiento de carátulas: lleva `generatedAt` adentro, o sea que
# es salida de una corrida, no fuente. Los scripts que lo producen sí se versionan.
/scripts/covers-found.json
# Caché de Python de las herramientas de `scripts/tools/`
__pycache__/
*.pyc
# MIDI bajados por los scripts de descubrimiento: contenido de terceros y
# regenerable, no fuente del proyecto.
/downloads_midi/

# Volcados crudos de la investigación de librerías de samples.
# Son listados de API regenerables (miles de entradas, MBs); el informe con las
# conclusiones sí se versiona en docs/investigacion-samples-instrumentos-reales.md
/*_tree.json
/waf_*.csv
/waf_*.txt

# Sensitive files
*.pem
*.key
secrets.json


# AWS Bedrock credentials (NEVER commit)
*-api-key.csv
*-api-key.json
bedrock-*.csv
*.aws-credentials

# Snapshot de la UI de una herramienta externa (claude-mem), no es del proyecto
/claude-mem-viewer-snapshot.md
