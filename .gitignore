*.exe
*.dmg
*.msi
*.deb
*.rpm
*.AppImage

# Screenshots & test artifacts (root only)
/*.png
/screenshots/
/.playwright-mcp/

# Playwright artifacts (see playwright.config.ts)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

