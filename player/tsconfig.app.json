{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting — los mismos límites que la app del piano */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* El código compartido vive fuera de `player/`: los alias son los MISMOS que
       usa Vite (ver vite.config.ts), así que el type-check corre sobre los
       MISMOS archivos que se bundlean. Si se declara en un solo lado, la app
       compila y `tsc -b` falla, o al revés.

       Sin `baseUrl`: está deprecado en TypeScript 6 y las rutas de `paths` se
       resuelven relativas a este archivo, que es exactamente lo que queremos. */
    "paths": {
      "@shared/*": ["../packages/*"],
      "@engine/*": ["../app/src/engine/*"],
      "@app/*": ["../app/src/*"]
    }
  },
  /* Se incluye `../packages` entero: el reproductor type-checkea TODO el código
     compartido, que es el punto de "todo lo nuevo se verifica en el
     reproductor".

     `../app/src/engine` sigue en la lista porque el motor TODAVÍA no se movió
     (fase 2). Se saca en la fase 2, cuando `engine/` ya viva en `packages/`. */
  "include": ["src", "../packages", "../app/src/engine"]
}
